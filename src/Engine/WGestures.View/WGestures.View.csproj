<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>WGestures.View</AssemblyName>
    <RootNamespace>WGestures.View</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../WGestures.View/Impl/Windows/CanvasWindowGestureView.cs" Link="Impl/Windows/CanvasWindowGestureView.cs" />
    <ProjectReference Include="../WGestures.Common/WGestures.Common.csproj" />
    <ProjectReference Include="../WGestures.Core/WGestures.Core.csproj" />

  </ItemGroup>
</Project>
