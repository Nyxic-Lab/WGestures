<Window
    x:Class="WGestures.Modern.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nyxic Gestures · Preview">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="Surface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
            <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"/>
            <DataTemplate x:Key="GestureRowTemplate">
                <Grid ColumnSpacing="12" Padding="8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" MinHeight="52" Padding="8">
                        <TextBlock Text="{Binding Path=Path}" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="236"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Padding="12,20,8,20" Spacing="5">
                    <TextBlock Text="Nyxic Gestures" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="WORKSPACE PREVIEW" FontSize="11" Opacity="0.65"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" Icon="Home"/>
                <NavigationViewItem Content="Gestures" Tag="gestures" Icon="Edit"/>
                <NavigationViewItem Content="Applications" Tag="apps" Icon="AllApps"/>
                <NavigationViewItem Content="Corners &amp; edges" Tag="corners" Icon="FullScreen"/>
                <NavigationViewItem Content="Preferences" Tag="settings" Icon="Setting"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="about" Icon="Help"/>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Padding="28,24,28,12" Spacing="5">
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PageHost" Padding="28,10,28,26" Spacing="16"/>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Padding="28,12">
                        <StackPanel Spacing="8">
                            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True"/>
                            <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Configuration preview · The mouse gesture engine is not connected."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
